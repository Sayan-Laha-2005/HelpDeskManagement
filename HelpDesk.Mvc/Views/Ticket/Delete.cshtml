@model Ticket
@{
    ViewData["Title"] = "Delete Ticket";
}

<h2>Delete Ticket #@Model.Id</h2>
<p>Are you sure you want to delete this ticket?</p>
<table>
    <tr><th>Title</th><td>@Model.Title</td></tr>
    <tr><th>Priority</th><td>@Model.Priority</td></tr>
    <tr><th>Status</th><td>@Model.Status</td></tr>
    <tr><th>Raised By</th><td>@Model.RaisedBy</td></tr>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Delete</button>
    <a href="@Url.Action("Index")">Cancel</a>
</form>
